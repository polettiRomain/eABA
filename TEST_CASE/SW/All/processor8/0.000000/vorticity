FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0.000000";
    object      vorticity;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    walls
    {
        type            calculated;
        value           nonuniform List<vector> 0();
    }
    overset2
    {
        type            overset;
        value           uniform (0 0 0);
    }
    hole
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    procBoundary8to0
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary8to7
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary8to9
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary8to11
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary8to12
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary8to13
    {
        type            processor;
        value           uniform (0 0 0);
    }
}


