    {
        type            zeroGradient;
    }
    overset2
    {
        type            zeroGradient;
        patchType       overset;
    }
    hole
    {
        type            zeroGradient;
    }
    procBoundary4to0
    {
        type            processor;
    }
    procBoundary4to3
    {
        type            processor;
    }
    procBoundary4to5
    {
        type            processor;
    }
    procBoundary4to6
    {
        type            processor;
    }
    procBoundary4to17
    {
        type            processor;
    }
    procBoundary4to18
    {
        type            processor;
    }
    procBoundary4to21
    {
        type            processor;
    }
    procBoundary4to23
    {
        type            processor;
    }
    procBoundary4to26
    {
        type            processor;
    }
}


