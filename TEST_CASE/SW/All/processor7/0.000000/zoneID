FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0.000000";
    object      zoneID;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    walls
    {
        type            zeroGradient;
    }
    overset2
    {
        type            overset;
        value           uniform 1;
    }
    hole
    {
        type            zeroGradient;
    }
    procBoundary7to8
    {
        type            processor;
        value           uniform 1;
    }
    procBoundary7to9
    {
        type            processor;
        value           uniform 1;
    }
    procBoundary7to10
    {
        type            processor;
        value           uniform 1;
    }
    procBoundary7to13
    {
        type            processor;
        value           uniform 1;
    }
}


