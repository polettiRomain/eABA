FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0.000000";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    walls
    {
        type            zeroGradient;
    }
    overset2
    {
        type            overset;
        value           nonuniform List<scalar> 0();
    }
    hole
    {
        type            nutkWallFunction;
        blending        stepwise;
        value           nonuniform List<scalar> 0();
    }
    procBoundary16to14
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary16to15
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary16to17
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary16to19
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary16to20
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary16to24
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary16to25
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary16to27
    {
        type            processor;
        value           uniform 0;
    }
}


