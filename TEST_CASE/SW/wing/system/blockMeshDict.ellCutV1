FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// https://www.openfoam.com/documentation/guides/latest/doc/openfoam-guide-expression-syntax.html

#include        "./../All/system/domainSetting"

scale   0.001;

chord_root #eval "4/degToRad(180)*$chord";
span2 #eval "$span/2";


//chord_spantestt #eval "$chord_root*test"
//chord_spantest #eval "$chord_span2*test"

thickOverset #eval "$chord*$factorChord";
thickX #eval "$thickOverset";
thickY #eval "$thickOverset";
thickZ #eval "$thickOverset";

// Dimension of the hole: used by topoSet
X0_hole 0; //#eval "$thickOverset/1000";
X1_hole #eval "($span)/1000";     //"($thickOverset+$span)/1000";
Y0_hole #eval "-$thickness/1000"; // +0.0001
Y1_hole #eval "$thickness/1000"; // +0.0001
Z0_hole #eval "-$chord_root/2/1000";
Z1_hole #eval "$chord_root/2/1000";

// Body-fitted grid
OST0_X0  #eval "-$thickX"; //#eval "-$thickX";
OST0_Y0  #eval "-$thickness/2";  
OST0_Y00  #eval "-$thickness/2 - $thickY";
OST0_X1  #eval "$X0_hole + $span + $thickX";
OST0_Y1  #eval "$thickness/2";  
OST0_Y11  #eval "$thickness/2 + $thickY";  
Xmid #eval "$X0_hole + $span";


Zmid 0;
factorZmid 2;
Zmidup #eval "$factorZmid*1";
Zmiddown #eval "-$Zmidup";
Zell_up #eval "$Zmid + $chord_root/2";
Zell_down #eval "$Zmid - $chord_root/2";
Z0 #eval "$Zmid -$chord_root/2 - $thickZ";
Z1 #eval "$Zmid + $chord_root/2 + $thickZ";

N_z 35; //c6-35-0.003 50 40 first setting
N_x #eval "ceil($N_z*($span+2*$thickX)/($chord+2*$thickZ))";
N_y #eval "ceil($N_z*($thickness+2*$thickY)/($chord+2*$thickZ))";

// Interpolation point to define the ellipsoid shape in the edges part
chord_span2 #eval "sqrt(3)/2*4/degToRad(180)*$chord/2"; 
mchord_span2 #eval "-$chord_span2"; 
span22 #eval "($OST0_X1-$X0_hole)/2";
chord2_span2 #eval "sqrt(3)/2*($Z1-$Zmid)"; 
mchord2_span2 #eval "-$chord2_span2"; 

Nz_block 20;

gradZm 8.95;
gradZp 0.111731843575419;

Nz_Othick 24;

vertices
(
// block 0
($OST0_X0 $OST0_Y1 $Zmid)
($X0_hole $OST0_Y1 $Zmid)
($X0_hole $OST0_Y1 $Zell_up)
($OST0_X0 $OST0_Y1 $Zell_up)
($OST0_X0 $OST0_Y0 $Zmid)
($X0_hole $OST0_Y0 $Zmid)
($X0_hole $OST0_Y0 $Zell_up)
($OST0_X0 $OST0_Y0 $Zell_up)

// block 1 
($X0_hole $OST0_Y1 $Z1) //8
($OST0_X0 $OST0_Y1 $Z1)
($X0_hole $OST0_Y0 $Z1)
($OST0_X0 $OST0_Y0 $Z1)

// block 2
($Xmid    $OST0_Y1 $Zmid) //12
($OST0_X1 $OST0_Y1 $Zmid)
($Xmid    $OST0_Y0 $Zmid) 
($OST0_X1 $OST0_Y0 $Zmid)

// block 3
($OST0_X0 $OST0_Y1 $Zell_down) //16
($X0_hole $OST0_Y1 $Zell_down)
($OST0_X0 $OST0_Y0 $Zell_down)
($X0_hole $OST0_Y0 $Zell_down)

// block 4
($OST0_X0 $OST0_Y1 $Z0) //20
($X0_hole $OST0_Y1 $Z0)
($OST0_X0 $OST0_Y0 $Z0)
($X0_hole $OST0_Y0 $Z0)

// block 5

// block 6
($OST0_X0 $OST0_Y11 $Zmid) //24
($X0_hole $OST0_Y11 $Zmid) // 25
($X0_hole $OST0_Y11 $Zell_up)
($OST0_X0 $OST0_Y11 $Zell_up)

// block 7
($X0_hole $OST0_Y11 $Z1) //28
($OST0_X0 $OST0_Y11 $Z1)

// block 8
($Xmid    $OST0_Y11 $Zmid) // 30
($OST0_X1 $OST0_Y11 $Zmid)

// block 9

// block 10
($OST0_X0 $OST0_Y11 $Zell_down) // 32
($X0_hole $OST0_Y11 $Zell_down)

// block 11
($OST0_X0 $OST0_Y11 $Z0) //34
($X0_hole $OST0_Y11 $Z0) // 35

// block 12

// block 13

// block14
($OST0_X0 $OST0_Y00 $Zmid) //36
($X0_hole $OST0_Y00 $Zmid) //37
($X0_hole $OST0_Y00 $Zell_up) //38 
($OST0_X0 $OST0_Y00 $Zell_up) //39

// block15
($X0_hole $OST0_Y00 $Z1) //40
($OST0_X0 $OST0_Y00 $Z1) //41

// block16
($Xmid    $OST0_Y00 $Zmid) // 42
($OST0_X1 $OST0_Y00 $Zmid)

// block 17

// block 18
($OST0_X0 $OST0_Y00 $Zell_down) // 44
($X0_hole $OST0_Y00 $Zell_down)

// block 19
($OST0_X0 $OST0_Y00 $Z0) //46
($X0_hole $OST0_Y00 $Z0) //47

// block 20
($Xmid    $OST0_Y1 $Zmidup) //48
($OST0_X1 $OST0_Y1 $Zmidup) //49
($Xmid    $OST0_Y0 $Zmidup) //50
($OST0_X1 $OST0_Y0 $Zmidup) //51

// block 21
($Xmid    $OST0_Y1 $Zmiddown) //52
($OST0_X1 $OST0_Y1 $Zmiddown) //53
($Xmid    $OST0_Y0 $Zmiddown) //54
($OST0_X1 $OST0_Y0 $Zmiddown) //55

// block 22
($Xmid    $OST0_Y11 $Zmidup) //56
($OST0_X1 $OST0_Y11 $Zmidup) //57

// block 23
($Xmid    $OST0_Y11 $Zmiddown) //58
($OST0_X1 $OST0_Y11 $Zmiddown) //59

//block 24
($Xmid    $OST0_Y00 $Zmidup) //60
($OST0_X1 $OST0_Y00 $Zmidup) //61

// block 25
($Xmid    $OST0_Y00 $Zmiddown) //62
($OST0_X1 $OST0_Y00 $Zmiddown) //63

);

blocks
(

    hex (0 1 2 3 4 5 6 7)          ($Nz_block 8 1) simpleGrading (1 1 1) //0
    hex (3 2 8 9 7 6 10 11)        ($Nz_block 24 1) simpleGrading (1 $gradZm 1) 
    hex (2 48 49 8 6 50 51 10)     (24 24 1) simpleGrading (1 $gradZm 1)
    hex (12 13 49 48 14 15 51 50)  (24 8 1) simpleGrading ($gradZm 1 1) // rect
    hex (16 17 1 0 18 19 5 4)      ($Nz_block 8 1) simpleGrading (1 1 1)
    hex (20 21 17 16 22 23 19 18)  ($Nz_block 24 1) simpleGrading (1 $gradZp 1)
    hex (21 53 52 17 23 55 54 19)  (24 24 1) simpleGrading (1 $gradZp 1)
    hex (52 53 13 12 54 55 15 14 19)  (24 8 1) simpleGrading ($gradZm  1 1)   // rect

    // Yup
    // Yup-Zup 
    hex (24 25 26 27 0 1 2 3)     ($Nz_block 8 $Nz_Othick) simpleGrading  (1 1 $gradZp)
    hex (27 26 28 29 3 2 8 9)     ($Nz_block 24 $Nz_Othick) simpleGrading (1 8.95 $gradZp)
    hex (26 56 57 28 2 48 49 8)   (24 24 $Nz_Othick) simpleGrading (1 8.95 $gradZp)
    hex (26 25 30 56 2 1 12 48)   (8 24 $Nz_Othick) simpleGrading  (1 1 $gradZp) // ellipsoid 9
    hex (30 31 57 56 12 13 49 48)   (24 8 $Nz_Othick) simpleGrading ($gradZm 1 $gradZp) // rect-ell

    // Yup-Zlow 
    hex (32 33 25 24 16 17 1 0)    ($Nz_block 8 $Nz_Othick) simpleGrading  (1 1 $gradZp)
    hex (34 35 33 32 20 21 17 16)  ($Nz_block 24 $Nz_Othick) simpleGrading (1 0.111731843575419 $gradZp)
    hex (35 59 58 33 21 53 52 17)  (24 24 $Nz_Othick) simpleGrading (1 0.111731843575419 $gradZp)
    hex (25 33 58 30 1 17 52 12)   (8 24 $Nz_Othick) simpleGrading  (1 1 $gradZp) // // ellipsoid  13 // !! grading
    hex (58 59 31 30 52 53 13 12)   (24 8 $Nz_Othick) simpleGrading ($gradZm 1 $gradZp) // rect-ell

    // Ydown
    // Zup
    hex (4 5 6 7 36 37 38 39)       ($Nz_block 8 $Nz_Othick) simpleGrading (1 1 $gradZm)
    hex (7 6 10 11 39 38 40 41)     ($Nz_block 24 $Nz_Othick) simpleGrading (1 $gradZm $gradZm)
    hex (6 50 51 10 38 60 61 40)    (24 24 $Nz_Othick) simpleGrading (1 $gradZm $gradZm)   
    hex (5 14 50 6 37 42 60 38)     (24 8 $Nz_Othick) simpleGrading (1 1 $gradZm) // ellipsoid 
    hex (14 15 51 50 42 43 61 60)     (24 8 $Nz_Othick) simpleGrading ($gradZm 1 $gradZm) // rect-ell 

    // Zdown
    hex (18 19 5 4 44 45 37 36)     ($Nz_block 8 $Nz_Othick) simpleGrading (1 1 $gradZm)
    hex (22 23 19 18 46 47 45 44)   ($Nz_block 24 $Nz_Othick) simpleGrading (1 $gradZp $gradZm)
    hex (23 55 54 19 47 63 62 45)      (24 24 $Nz_Othick) simpleGrading (1 $gradZp $gradZm)
    hex (5 19 54 14 37 45 62 42)    (8 24 $Nz_Othick) simpleGrading (1 1 $gradZm) // ellipsoid  // !! grading 
    hex (54 55 15 14 62 63 43 42)     (24 8 $Nz_Othick) simpleGrading ($gradZm 1 $gradZm) // rect-ell 
);

edges
(
// YLevel 0
//// up
