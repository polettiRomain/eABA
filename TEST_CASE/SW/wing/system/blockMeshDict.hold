FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// https://www.openfoam.com/documentation/guides/latest/doc/openfoam-guide-expression-syntax.html
scale   0.001;



// In [mm]
// Center of the domain: (0,0)

// Wing dimension
chord 10.0;
thickness 5.0;
span2 25.0; //span/2

// Motion
Aphi 80.0; // max flapping angle
d  #eval "floor($span2*sin(degToRad($Aphi)))"; // longitudinal component of the flapping motion of the middle span point following a circle //#eval "Info<< $d << endl"; //d2  #eval "floor($span2*sin(degToRad($Aphi)))" //d  #eval "$d2-$d";

// Airfoil extrimities
A_X0  #eval "-$chord/2*$scale";  
A_Y0  #eval "-$thickness/2*$scale"; // =0 due to lack of digit precision, not used
A_X1  #eval "$chord/2*$scale";  
A_Y1  #eval "$thickness/2*$scale"; // =0 due to lack of digit precision, not used


// square domain
domainL    #eval  "($chord*10.0)";  // *10/2
domain_XY0 0; 
domain_XY1 #eval "$domainL"; 

// thickness overset 
//thickX #eval "$chord/10*2";
//thickY #eval "$chord/10*2";

thickX #eval "$chord/2";
thickY #eval "$chord/2";

// Block0
OST0_X0  #eval "($domainL/2 - $d) - $thickness/2 - $thickX";  
OST0_Y0  #eval "$domainL/2-$chord/2 - $thickY";
OST0_X1  #eval "($domainL/2.0) -$d  - $thickness/2";  
OST0_Y1  #eval "$domainL/2-$chord/2";
// Block1
OST1_X1  #eval "($domainL/2-$d) + $thickness/2";  
// Block2
OST2_X1  #eval "($domainL/2 - $d) + $thickness/2 + $thickX";  
// Block3
OST3_Y1  #eval "$domainL/2+$chord/2";
// Block4
OST4_Y1  #eval "$domainL/2 + $chord/2 + $thickY";

Z0 0;
Z1 10;

N_y 40;
N_x #eval "ceil($N_y*(2*$thickX+$thickness)/($chord+2*$thickX))";

Ny #eval "ceil($N_y*$chord/($chord+2*$thickY))";
ny #eval "ceil($N_y*$thickY/($chord+2*$thickY))";

Nx #eval "ceil($N_x*$thickness/($thickness+2*$thickX))";
nx #eval "ceil($N_x*$thickX/($thickness+2*$thickX))";


vertices
(
    ($OST0_X0  $OST0_Y0  $Z0)
    ($OST0_X1  $OST0_Y0  $Z0)
    ($OST0_X1  $OST0_Y1  $Z0)
    ($OST0_X0  $OST0_Y1  $Z0)
    ($OST0_X0  $OST0_Y0  $Z1)
    ($OST0_X1  $OST0_Y0  $Z1)
    ($OST0_X1  $OST0_Y1  $Z1)
    ($OST0_X0  $OST0_Y1  $Z1) //-- Block0

    ($OST1_X1  $OST0_Y0  $Z0) // 8
    ($OST1_X1  $OST0_Y1  $Z0) // 9
    ($OST1_X1  $OST0_Y0  $Z1) // 10
    ($OST1_X1  $OST0_Y1  $Z1) // 11

    ($OST2_X1  $OST0_Y0  $Z0) // 12
    ($OST2_X1  $OST0_Y1  $Z0) // 13
    ($OST2_X1  $OST0_Y0  $Z1) // 14
    ($OST2_X1  $OST0_Y1  $Z1) // 15

    ($OST2_X1  $OST3_Y1  $Z0) // 16
    ($OST1_X1  $OST3_Y1  $Z0) // 17
    ($OST2_X1  $OST3_Y1  $Z1) // 18
    ($OST1_X1  $OST3_Y1  $Z1) // 19

    ($OST2_X1  $OST4_Y1  $Z0) // 20
    ($OST1_X1  $OST4_Y1  $Z0) // 21
    ($OST2_X1  $OST4_Y1  $Z1) // 22
    ($OST1_X1  $OST4_Y1  $Z1) // 23

    ($OST0_X1  $OST3_Y1  $Z0) // 24
    ($OST0_X1  $OST4_Y1  $Z0) // 25
    ($OST0_X1  $OST3_Y1  $Z1) // 26
    ($OST0_X1  $OST4_Y1  $Z1) // 27

    ($OST0_X0  $OST3_Y1  $Z0) // 28
    ($OST0_X0  $OST4_Y1  $Z0) // 29
    ($OST0_X0  $OST3_Y1  $Z1) // 30
    ($OST0_X0  $OST4_Y1  $Z1) // 31
);

blocks
(
    hex (0 1 2 3 4 5 6 7)        ($nx $ny 1) simpleGrading (1 1 1)
    hex (1 8 9 2 5 10 11 6)      ($Nx $ny 1) simpleGrading (1 1 1)
    hex (8 12 13 9 10 14 15 11)  ($nx $ny 1) simpleGrading (1 1 1)
    hex (9 13 16 17 11 15 18 19) ($nx $Ny 1) simpleGrading (1 1 1)
    hex (17 16 20 21 19 18 22 23)($nx $ny 1) simpleGrading (1 1 1)
    hex (24 17 21 25 26 19 23 27)($Nx $ny 1) simpleGrading (1 1 1)
    hex (28 24 25 29 30 26 27 31)($nx $ny 1) simpleGrading (1 1 1)
    hex (3 2 24 28 7 6 26 30)    ($nx $Ny 1) simpleGrading (1 1 1)

);

edges
(
);

boundary
(
